--- a/transport/internet/handshake_limit.go
+++ b/transport/internet/handshake_limit.go
@@ -0,0 +1,38 @@
+package internet
+
+import (
+	"net"
+
+	"github.com/xtls/xray-core/common/errors"
+)
+
+// MaxHandshakeResponse is how much a dialer reads from the server before its handshake response ends. Go's HTTP
+// response parser keeps a header line whole however long it is, so a server that never ends one would fill memory.
+const MaxHandshakeResponse = 64 * 1024
+
+// HandshakeLimitedConn fails its reads once MaxHandshakeResponse bytes have been read, until Unlimit.
+type HandshakeLimitedConn struct {
+	net.Conn
+	read      int
+	unlimited bool
+}
+
+func (c *HandshakeLimitedConn) Read(b []byte) (int, error) {
+	if c.unlimited {
+		return c.Conn.Read(b)
+	}
+	if c.read >= MaxHandshakeResponse {
+		return 0, errors.New("server handshake response longer than 64 KiB")
+	}
+	if len(b) > MaxHandshakeResponse-c.read {
+		b = b[:MaxHandshakeResponse-c.read]
+	}
+	n, err := c.Conn.Read(b)
+	c.read += n
+	return n, err
+}
+
+// Unlimit lifts the limit once the handshake is done.
+func (c *HandshakeLimitedConn) Unlimit() {
+	c.unlimited = true
+}
